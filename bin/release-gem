#!/usr/bin/env ruby
# frozen_string_literal: true

# Released under the Apache License, Version 2.0.
# Copyright, 2026, by General Intelligence Systems.

# RELEASE-GEM(1)                     General Commands Manual                   RELEASE-GEM(1)
#
# NAME
#      bin/release-gem — publish this version
#
# SYNOPSIS
#      bin/release-gem
#
# DESCRIPTION
#      Builds libgweather-X.Y.Z.gem and pushes it.  One gem, not a per-platform set: this
#      gem is pure Ruby, the binding being GObjectIntrospection::Loader reading
#      GWeather-4.0.typelib at require time, so there is no object to precompile and no
#      Cross Compile workflow to download artifacts from.  That is what an earlier version
#      of this script did, and it is why there is no longer a cross-compile.yml.
#
#      A gem which is already on RubyGems is reported rather than failed, so a release which
#      died part way through can be run again.
#
#      It is not `gem kit release`, which this could reasonably become.  The reason to keep a
#      script is the version check below: the local version must be ahead of what is
#      published, which is the one mistake that cannot be taken back.  The cost is skipping
#      the gates `gem kit release` applies — a changelog entry for this version, no due
#      deprecation deadline, a clean working tree — so run `gem kit release --dry-run` first
#      to get them.
#
# EXIT STATUS
#      The bin/release-gem utility exits 0 on success, and >0 if an error occurs.
#
# SEE ALSO
#      bin/test(1), gem(1), .github/workflows/test.yml
#
# libgweather                             November 3, 2026                  RELEASE-GEM(1)

require_relative "../lib/libgweather/version"
require "open3"

local_version = Libgweather::VERSION
gem_name = "libgweather"
gemspec = "libgweather.gemspec"

puts "Local version: #{local_version}"

# The local version has to be ahead of what is published, which is the one mistake that cannot be taken back: a pushed version is pushed.
remote_output = `gem specification #{gem_name} version --remote 2>&1`

if $?.success?
  remote_version = remote_output[/version: (.+)/, 1]&.strip
  puts "Remote version: #{remote_version}"

  if Gem::Version.new(local_version) <= Gem::Version.new(remote_version)
    abort "ERROR: Local version (#{local_version}) has not been incremented past remote (#{remote_version})"
  end
else
  puts "Gem not yet published remotely, proceeding with first release"
end

puts "\nBuilding #{gem_name} #{local_version} from #{gemspec}..."

system("gem build #{gemspec}") || abort("ERROR: gem build failed")

built = "#{gem_name}-#{local_version}.gem"

# The gem must stay pure Ruby. The test workflow asserts this too, but a release can be cut
# from a working tree CI never saw, so it is checked here as well.
spec = Gem::Specification.load(gemspec)

unless spec.extensions.empty?
  abort "ERROR: the gemspec declares extensions (#{spec.extensions.join(', ')}); this gem is pure Ruby"
end

puts "\nPushing #{built}..."

out, status = Open3.capture2e("gem", "push", built)

print out

if !status.success?
  if out.include?("has already been pushed")
    puts "  (already published — nothing to do)"
  else
    abort "ERROR: gem push failed for #{built}"
  end
end

puts "\nReleased #{gem_name} #{local_version}"

tag = "v#{local_version}"

system("git", "tag", "-a", tag, "-m", "Release #{local_version}")
system("git", "push", "origin", tag)
